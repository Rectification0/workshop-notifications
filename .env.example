# --- Backend ---
# URL-encode special characters in the password (e.g. "@" -> "%40")
DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5432/workshops
PORT=3000
NOTIFIER_URL=http://localhost:4000/notify

# --- Dispatcher ---
POLL_INTERVAL_MS=1000
BATCH_SIZE=20
REQUEST_TIMEOUT_MS=3000
# Must be greater than REQUEST_TIMEOUT_MS
LEASE_MS=30000
BACKOFF_BASE_MS=1000
BACKOFF_MAX_MS=30000

# --- Mock notification service ---
MOCK_PORT=4000
MOCK_FAILURE_RATE=0.2
MOCK_TIMEOUT_RATE=0.2
# Must be greater than REQUEST_TIMEOUT_MS
MOCK_TIMEOUT_DELAY_MS=10000

# --- Demo ---
BACKEND_URL=http://localhost:3000
MOCK_URL=http://localhost:4000
